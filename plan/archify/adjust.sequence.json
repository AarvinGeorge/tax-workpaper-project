      "label": "Next.js route",
      "sublabel": "api/w/[ws]/* + page render"
    },
    {
      "id": "server",
      "type": "security",
      "label": "Server state",
      "sublabel": "state.ts + can()"
    },
    {
      "id": "neon",
      "type": "database",
      "label": "Neon Postgres",
      "sublabel": "workpaper_events"
    },
    {
      "id": "priya",
      "type": "frontend",
      "label": "Priya's browser",
      "sublabel": "preparer tab"
    }
